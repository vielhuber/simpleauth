{
    "name": "vielhuber/simpleauth",
    "description": "Simple php authentication library.",
    "require": {
        "php": "^8.5",
        "vielhuber/dbhelper": "^2.5.5",
        "firebase/php-jwt": "^7.1.0",
        "vielhuber/comparehelper": "^1.2.0",
        "vielhuber/stringhelper": "^7.3.6",
        "vlucas/phpdotenv": "^5.6.4",
        "web-auth/webauthn-lib": "^5.3.5",
        "vielhuber/mailhelper": "^1.8.3"
    },
    "license": "MIT",
    "autoload": {
        "classmap": [
            "src/simpleauth.php"
        ],
        "psr-4": {
            "vielhuber\\simpleauth\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13"
    }
}
